# Local Community Edition development configuration.
# Copy this file to .env in the Activepieces repository root, then fill the secrets.
# Start with npm start; .env overrides .env.dev defaults through tools/ce/config.cjs.
# See CE-SETUP-REPORT.md for dependency installation and setup on another PC.
# Commit this example; keep your filled .env private.

# The CE launcher forces this edition. dev enables the local development setup.
AP_EDITION=ce
AP_ENVIRONMENT=dev

# Embedded PGLite database; no Postgres server or credentials are needed.
# Data, including flows and connections, persists under dev/config/pglite.
AP_DB_TYPE=PGLITE
AP_CONFIG_PATH=./dev/config

# Disposable worker cache. It can be rebuilt on another PC.
AP_CACHE_BASE_PATH=./dev/cache

# Comma-separated source folder names to build and expose in the editor.
# Both npm start and npm run ce:build read this list. Restart after changing it.
# Install dependencies for any newly selected workspaces with Bun first.
AP_DEV_PIECES=webhook,http,mcp,data-mapper,json,data-summarizer,delay,forms,sftp,schedule,xml,approval

# Public UI address used for generated links and webhook URLs.
# The local launcher expects UI 4200, API 3000 and worker health 3001.
AP_FRONTEND_URL=http://localhost:4200

# Load the selected local pieces without syncing the remote catalogue.
AP_PIECES_SYNC_MODE=NONE

# A Redis server must listen here. The launcher checks port 16379.
# On a new Windows PC, provide Redis through WSL Ubuntu; see the setup report.
# Queue persistence is disabled in the local setup; recreate Redis on the new PC.
# Do not add AP_QUEUE_MODE=MEMORY: legacy compatibility code changes Redis selection.
AP_REDIS_TYPE=STANDALONE
AP_REDIS_HOST=127.0.0.1
AP_REDIS_PORT=16379

# REQUIRED: exactly 32 characters used to encrypt saved connections.
# For a NEW database, generate one: node -e "console.log(require('node:crypto').randomBytes(16).toString('hex'))"
# If moving an existing PGLite database, preserve its original encryption key.
AP_ENCRYPTION_KEY=

# REQUIRED: persistent JWT signing secret. Keep it private and stable.
# For a NEW installation: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# AP_WORKER_TOKEN is omitted: the launcher signs a matching worker token automatically.
AP_JWT_SECRET=

# Set this on each PC to the absolute path of the REAL Deno executable.
# Needed for Deno Code steps, code transpilation and script expressions in inputs.
# The app can boot with it empty, but those execution features will fail.
# Example on Windows: C:/Tools/deno/deno.exe (an npm .cmd shim will not work).
AP_DENO_PATH=

# Execution mode used by this local development setup.
AP_EXECUTION_MODE=UNSANDBOXED

# Local defaults: disable telemetry, cloud authentication and the Redis queue UI.
# Queue UI credentials are unnecessary while AP_QUEUE_UI_ENABLED=false.
AP_TELEMETRY_ENABLED=false
AP_CLOUD_AUTH_ENABLED=false
AP_QUEUE_UI_ENABLED=false

# Development log verbosity and human-readable console output.
AP_LOG_LEVEL=debug
AP_LOG_PRETTY=true

# Webhook response timeout in seconds; polling interval in minutes.
AP_WEBHOOK_TIMEOUT_SECONDS=30
AP_TRIGGER_DEFAULT_POLL_INTERVAL=5

# Skip development piece translations unless you are working on translations.
AP_LOAD_TRANSLATIONS_FOR_DEV_PIECES=false

# Keep semantic MCP tool search disabled; no OpenAI key is needed for this setting.
AP_TOOL_SEARCH_ENABLED=false

# Omitted for this setup: Postgres credentials, AP_API_KEY, AP_WEBHOOK_URL,
# AP_CACHE_PATH and service-role overrides. The launcher configures its worker URL.
